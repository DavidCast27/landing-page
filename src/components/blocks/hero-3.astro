---
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import { Image } from "@/components/ui/image"
import {
  Section,
  SectionActions,
  SectionContent,
  SectionMedia,
  SectionProse,
} from "@/components/ui/section"

interface Props {
  class?: string
  id?: string
  links?: {
    text?: string
    href?: string
    icon?: string
    target?: string
  }[]
  image?: {
    src: string
    alt: string
  }
}

const { class: className, id, links, image } = Astro.props
---

<Section class={className} id={id} size="lg">
  <SectionContent class="items-center">
    <SectionProse class="text-center text-balance" size="lg">
      <slot />
    </SectionProse>
    <SectionActions class="justify-center">
      {
        links?.map(({ icon, text, ...link }, i) => (
          <Button
            variant={i === 0 ? "default" : "secondary"}
            size="lg"
            {...link}
          >
            {icon && <Icon name={icon} />}
            {text}
          </Button>
        ))
      }
    </SectionActions>
  </SectionContent>
  <SectionMedia class="absolute inset-0 rounded-none overflow-hidden bg-slate-50 dark:bg-slate-950">
    <!-- Premium glowing orbs effect (adapts to light/dark) -->
    <div class="absolute -top-[300px] -right-[300px] h-[800px] w-[800px] rounded-full bg-amber-400/20 dark:bg-amber-600/15 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-[300px] -left-[100px] h-[600px] w-[600px] rounded-full bg-indigo-400/20 dark:bg-indigo-600/15 blur-3xl pointer-events-none"></div>
    <!-- Gradient overlay to blend into the rest of the page -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-slate-50/90 dark:to-slate-950/90"></div>
    
    <!-- Optional: Keep the image but blend it softly if it exists -->
    {image?.src && (
      <Image
        class="absolute inset-0 h-full w-full object-cover opacity-10 mix-blend-overlay dark:opacity-10 dark:mix-blend-overlay"
        sizes="(min-width: 1536px) 1536px, 100vw"
        priority
        {...image}
      />
    )}
  </SectionMedia>
</Section>
